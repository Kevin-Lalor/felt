# FELT server — every value has a sensible default; nothing here is required
# to run locally. Secrets never go in the repo (CLAUDE.md "Never do").

# Network
PORT=8090
HOST=0.0.0.0

# Access control — the whole login is the invite code (share it), and the host
# code (keep it: whoever joins with it gets host powers and deals hand #1).
# Leave BOTH blank and the server generates fresh ones each boot and prints
# them. Set INVITE_CODE only when you want the same code across restarts —
# and never commit the one you actually play with.
INVITE_CODE=
HOST_CODE=

# Table setup
TABLE_NAME=Kevin's Home Game
SMALL_BLIND=1
BIG_BLIND=2
ANTE=0
MIN_BUYIN=100
MAX_BUYIN=400
