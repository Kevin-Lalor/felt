# FELT server — every value has a sensible default; nothing here is required
# to run locally. Secrets never go in the repo (CLAUDE.md "Never do").

# Network. Loopback only: cloudflared on the same machine is the only thing
# that should ever reach the server. HOST=0.0.0.0 opens it to your whole home
# network, past the Cloudflare Access login — only for testing on the LAN.
PORT=8090
HOST=127.0.0.1
# Open WebSockets allowed from one address at once. Friends playing together
# on one wifi share an address, so raise this if a houseful can't all join.
# MAX_CONNECTIONS_PER_IP=8
# Players one address may have at the table at once (connected, or away but
# still seated). Stops one person filling the table with ghost seats. Raise
# it if several friends play from the same house.
# MAX_PLAYERS_PER_IP=4

# Table codes — the second lock, behind Cloudflare Access. The invite code is
# for friends; the host code makes whoever joins with it host. Leave them
# UNSET (commented out) and the server makes strong random 16-character ones
# each boot and prints them. If you set one it must be 12+ characters and the
# two must differ — set-but-blank, too short, or equal and the server refuses
# to start. Never commit the ones you actually play with.
# INVITE_CODE=
# HOST_CODE=

# Table setup
TABLE_NAME=Kevin's Home Game
SMALL_BLIND=1
BIG_BLIND=2
ANTE=0
MIN_BUYIN=100
MAX_BUYIN=400
