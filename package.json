{
  "name": "poker",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:engine": "pnpm --filter @poker/engine test",
    "test:property": "pnpm --filter @poker/engine test:property",
    "test:leak": "pnpm --filter @poker/server test:leak",
    "test:integrity": "pnpm --filter @poker/server test:integrity",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "tokens": "tsx packages/tokens/build.ts",
    "verify-hand": "tsx tools/verify-hand.ts",
    "bot": "tsx tools/bot.ts",
    "db:migrate": "pnpm --filter @poker/server db:migrate",
    "db:snapshot": "pnpm --filter @poker/server db:snapshot",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.2"
  }
}
