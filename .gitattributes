# Normalize line endings in the repo (LF), regardless of the OS checking out.
# CI runs on Linux; development happens on Windows. Without this, every file
# looks modified when it crosses machines.
* text=auto eol=lf

# Lockfiles and generated CSS: keep them out of diffs and merge noise.
pnpm-lock.yaml -diff linguist-generated
packages/tokens/dist/** -diff linguist-generated

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
